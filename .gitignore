# ---- 工作区临时目录（本机暂存，一律不入库）----
.tmp_*/
.tmp_*
temp/

# ---- Python 字节码缓存（import 验收脚本时会生成）----
__pycache__/
*.py[cod]

# ---- StarRailRes 第三方仓库克隆（体积大、含版权素材，不入库）----
